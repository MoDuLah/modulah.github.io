                version: '[ALPHA]',
                category: 'Asset management',
                badge: 'dev',
                badgeText: 'DEV',
                iconPath: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>',
                config: '{"chart_renderer": "webgl", "historical_data": 365}'
            },
            {
                id: 'modulHubControl',
                tier: 'free',
                title: 'MoDuL Hub Control Room',
                desc: 'Centralized control system for MoDuL utilities.',
                version: 'v0.2.10',
                category: 'Utility',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<path d="M3 3h18v18H3z"></path>',
                config: '{}'
            },
            {
                id: 'cracked',
                tier: 'free',
                title: 'cRaCked',
                desc: 'High-performance cracking utility framework.',
                version: 'v1.3.1',
                category: 'Utility',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>',
                config: '{"threads": 4, "mode": "stealth"}'
            },
            {
                id: 'raceTracker',
                tier: 'free',
                title: 'Race Tracker',
                desc: 'Real-time vector tracking for active circuits.',
                version: '[DEV]',
                category: 'Circuit tracking',
                badge: 'dev',
                badgeText: 'DEV',
                iconPath: '<path d="M4 19l16-14m0 0v8m0-8h-8"></path>',
