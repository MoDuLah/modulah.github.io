                config: '{}'
            },
            {
                id: 'smuggler',
                tier: 'free',
                title: 'Smuggler',
                desc: 'Travel and inventory optimization agent.',
                version: 'v3.0.6',
                category: 'Travel Utility',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<path d="M22 12h-4l-3-9L9 3l-3 9H2"></path>',
                config: '{}'
            },
            {
                id: 'jobCentrePlus',
                tier: 'web tools',
                title: 'JobCentre+',
                desc: 'Advanced company application and recruitment tool.',
                version: 'v1.2.0',
                category: 'Company Recruitment',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>',
                config: '{"auto_apply": true, "filter_stats": true}'
            },
            {
                id: 'pythagorasDashboard',
                tier: 'web tools',
                title: 'Pythagoras Project - Dashboard',
                desc: 'Web-based interface for CIS data aggregation.',
                version: 'v1.0.0',
                category: 'Dashboard',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line>',
                config: '{}'
            },
            {
                id: 'lap-recorder',
                tier: 'archive',
                title: 'Lap Recorder',
                desc: 'The lap-capture project that helped shape the next generation of racing tools. Retired from active promotion, but preserved on the hub as part of the journey.',
                version: 'v1.7.1',
                category: 'Archived racing project',
                badge: 'archive',
                badgeText: 'ARCHIVE',
                iconPath: '<image href="https://lh3.googleusercontent.com/aida-public/AB6AXuDbmK_RbWVhpeeraxON2kBwiL_RLDAQABFzld8-0m_qY4CGc21KEcPSm-QEDdw89B26ALU27BpFgwExTXyMUzwt30onBeHesQm_Y9coECCkA6k8DPwMpOyQhct2g4HwI5hH188xCdpbSySk_hLo7uOJ0lbUL0D7bg_iRnV4uhZBazvYrC_mzdOCDDrdk76lkAVfmMj7qy7rME_W2P906o8l5WcpWBG2GfkYtFhOIlYfUOETDUVVGjgaexsevCTTGG3xZA" x="0" y="0" width="24" height="24" />',
                config: '{"status": "archived"}',
                history: ['v1.7.1 - Theme-thread helper line', 'v1.7.0 - Larger recorder window', 'v1.6.9 - Official layout correction'],
                customContent: `
                    <article class="content-card content-card-full mb-6">
                      <h3 class="font-label-caps text-label-caps text-[#98f05f] uppercase tracking-widest mb-4">Project Termination Notice</h3>
                      <div class="text-on-surface-variant text-code-sm leading-relaxed space-y-4">
                          <p>After a long run of updates, fixes, experiments, and community feedback, I decided to officially terminate the Lap Recorder project.</p>
                          <p>This script started as a simple way to record and organise lap times, but over time it grew into something much bigger than its original purpose. It helped shape ideas, exposed limits, revealed better methods, and most importantly showed me what a proper racing tool should become.</p>
                          <p>For everyone who used it, tested it, reported bugs, suggested features, or simply trusted it during their racing grind: thank you. Your feedback pushed the project further than I originally expected.</p>
                          <p><strong>But this is not the end of the road.</strong> MoDuL's Pit Guru is already being forged in the garage.</p>
                          <p>MoDuL's Pit Guru is not meant to simply replace Lap Recorder. It is meant to go beyond it: faster, stronger, cleaner, smarter, and built to understand the race rather than only record what happened.</p>
                      </div>
                    </article>
                    <article class="content-card content-card-full">
                      <h3 class="font-label-caps text-label-caps text-[#98f05f] uppercase tracking-widest mb-4">What it leaves behind</h3>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-on-surface-variant text-code-sm leading-relaxed">
                        <div class="glass-panel p-4 rounded">
                          <h4 class="text-on-surface font-semibold mb-2">Lap capture foundation</h4>
                          <p>Lap Recorder built the early workflow for capturing lap times, comparing runs, and keeping race context tied to the session.</p>
                        </div>
                        <div class="glass-panel p-4 rounded">
                          <h4 class="text-on-surface font-semibold mb-2">Replay lessons</h4>
                          <p>It helped expose how replay timing, pause handling, finish detection, and race-state drift need to be treated in a better long-term tool.</p>
                        </div>
                        <div class="glass-panel p-4 rounded">
                          <h4 class="text-on-surface font-semibold mb-2">Records and exports</h4>
                          <p>The project proved there was real value in keeping local history, reusable reports, and track-aware results all in one place.</p>
                        </div>
                        <div class="glass-panel p-4 rounded">
                          <h4 class="text-on-surface font-semibold mb-2">Direction for the future</h4>
                          <p>The biggest thing it leaves behind is direction. Lap Recorder showed what the next racing project needs to become.</p>
                        </div>
                      </div>
                    </article>
                `
            }
        ];

        let currentFilter = 'ALL';

        function filterByTier(tier) {
            currentFilter = tier;
            document.getElementById('module-header-title').innerText = `Module Interface Array [${tier}]`;
            document.getElementById('module-filter-text').innerText = `FILTER: [${tier}]`;
            
            // hide script details if open
            document.getElementById('module-grid').classList.remove('hidden');
            document.getElementById('script-details-container').classList.remove('active');
            
            renderModules();
        }

        // Keep this for backwards compatibility with any remaining static links
        function filterByStatus(status) {
            filterByTier(status);
        }

        function renderModules() {
            const grid = document.getElementById('module-grid');
            const terminal = document.getElementById('cli-output');
            const oldCards = grid.querySelectorAll('.module-card');
            
            // Unload animation for existing cards
            oldCards.forEach(card => {
                card.classList.remove('fade-slide-up');
                card.classList.add('fade-slide-down');
            });

            // Wait for unload animation to complete
            setTimeout(() => {
                grid.innerHTML = '';
                
                let filteredScripts = scripts;
                if(currentFilter !== 'ALL') {
                    filteredScripts = scripts.filter(s => s.tier.toUpperCase() === currentFilter);
                }
                
                // Reset terminal for boot sequence
                terminal.innerHTML = `
                    <div class="opacity-70 typing-line" style="animation-duration: 0.3s;">&gt; INITIALISING MODUL SYSTEMS... <span class="text-secondary-fixed-dim">[OK]</span></div>
                    <div class="opacity-70 typing-line" style="animation-duration: 0.3s;">&gt; CONNECTING TO REGISTRY... <span class="text-secondary-fixed-dim">[OK]</span></div>
                    <div class="typing-line" id="cli-cursor-line">&gt; _<span class="blink-cursor inline-block w-2 h-3 bg-[#98f05f] translate-y-0.5 ml-1"></span></div>
                `;

                // Sequentially load modules with dynamic boot sequence
                filteredScripts.forEach((script, index) => {
                    setTimeout(() => {
                        const cardHtml = `
                        <div class="glass-panel module-card p-5 rounded-lg flex flex-col group cursor-pointer h-full fade-slide-up ${script.badge === 'dev' ? 'border-dashed opacity-70' : ''}" onclick="activateScript('${script.id}')">
                            <div class="flex justify-between items-start mb-4">
                                <div class="w-10 h-10 rounded border border-white/10 bg-surface-container-lowest/50 flex items-center justify-center group-hover:border-[#98f05f]/50 transition-colors">
                                    <svg class="w-6 h-6 text-[#98f05f]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                        ${script.iconPath}
                                    </svg>
                                </div>
                                <span class="status-chip ${script.badge} font-label-caps text-label-caps px-2 py-0.5">${script.badgeText}</span>
                            </div>
                            <div class="flex-1 ${script.badge === 'dev' ? 'group-hover:opacity-100 transition-opacity' : ''}">
                                <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-1 group-hover:text-[#98f05f] transition-colors">${script.title}</h3>
                                <p class="font-code-sm text-code-sm text-outline-variant">${script.desc}</p>
                            </div>
                            <div class="mt-4 pt-4 border-t border-white/5 font-code-sm text-code-sm text-[#98f05f]/80 flex justify-between ${script.badge === 'dev' ? 'group-hover:opacity-100 transition-opacity' : ''}">
                                <span class="">VER: ${script.version}</span>
                                <span class="material-symbols-outlined text-[16px] opacity-0 group-hover:opacity-100 transition-opacity">${script.badge === 'dev' ? 'build' : 'arrow_forward'}</span>
                            </div>
                        </div>`;
                        
                        grid.insertAdjacentHTML('beforeend', cardHtml);
                        
                        // Add line to terminal
                        const cursorLine = document.getElementById('cli-cursor-line');
                        const newLine = document.createElement('div');
                        newLine.className = 'opacity-100 typing-line text-outline-variant';
                        newLine.style.animationDuration = '0.2s';
                        newLine.innerHTML = `&gt; INITIALIZING MODULE: ${script.title.toUpperCase()}... <span class="text-[#98f05f]">[OK]</span>`;
                        terminal.insertBefore(newLine, cursorLine);
                        
                        // Auto-scroll terminal
                        terminal.scrollTop = terminal.scrollHeight;
                        
                    }, index * 150); // Stagger delay
                });
                
                // Final loading line
                setTimeout(() => {
                    const cursorLine = document.getElementById('cli-cursor-line');
                    const newLine = document.createElement('div');
                    newLine.className = 'opacity-100 typing-line';
                    newLine.id = 'cli-loading-line';
                    newLine.innerHTML = `&gt; MODULES LOADED (${filteredScripts.length})... <span class="text-[#98f05f] glow">[OK]</span>`;
                    terminal.insertBefore(newLine, cursorLine);
                    terminal.scrollTop = terminal.scrollHeight;
                }, filteredScripts.length * 150 + 200);

            }, oldCards.length > 0 ? 300 : 0);
        }

        function activateScript(scriptKey) {
            const data = scripts.find(s => s.id === scriptKey);
            if(!data) return;

            // Handle UI Switch
            document.getElementById('module-grid').classList.add('hidden');
            const detailContainer = document.getElementById('script-details-container');
            detailContainer.classList.add('active');
            
            document.getElementById('module-header-title').innerText = 'System Status: ' + data.title.toUpperCase();
            document.getElementById('module-filter-text').innerText = 'BACK TO OVERVIEW [X]';

            // Populate Data
            document.getElementById('detail-title').innerText = data.title;
            document.getElementById('detail-desc').innerText = data.desc;
            document.getElementById('detail-version').innerText = data.version;
            
            const badge = document.getElementById('detail-badge');
            badge.className = `status-chip ${data.badge} font-label-caps text-label-caps px-3 py-1`;
            badge.innerText = data.badgeText;

            const customContainer = document.getElementById('detail-custom-content');
            const defaultContent = document.getElementById('detail-default-content');
            
            if (data.customContent) {
                customContainer.innerHTML = data.customContent;
                customContainer.classList.remove('hidden');
                defaultContent.classList.add('hidden');
            } else {
                customContainer.innerHTML = '';
                customContainer.classList.add('hidden');
                defaultContent.classList.remove('hidden');
                
                if (data.history) {
                    const historyContent = document.getElementById('detail-history-content');
                    historyContent.innerHTML = data.history.map((h, i) => `
                        <div class="glass-panel p-4 rounded ${i === 0 ? 'border-l-2 border-[#98f05f]' : 'opacity-70'}">
                            <div class="flex justify-between items-center mb-2">
                                <span class="${i === 0 ? 'text-[#98f05f]' : 'text-on-surface'} font-code-sm">${h.split(' - ')[0]}</span>
                                ${i === 0 ? '<span class="text-outline-variant text-[11px] uppercase">Latest</span>' : ''}
                            </div>
                            <ul class="text-on-surface-variant text-code-sm list-disc list-inside flex flex-col gap-1">
                                <li>${h.split(' - ')[1]}</li>
                            </ul>
                        </div>
                    `).join('');
                }
            }

            // Trigger Boot Sequence
            const terminal = document.getElementById('cli-output');
            const cursorLine = document.getElementById('cli-cursor-line');
            
            const newLine = document.createElement('div');
            newLine.className = 'opacity-100 typing-line text-[#98f05f]';
            newLine.innerHTML = `> INITIALIZING MODULE [${data.title.toUpperCase()}] <span class="text-[#98f05f]/70 glow">v${data.version}</span>...`;
            
            terminal.insertBefore(newLine, cursorLine);
            
            // Scroll to bottom of terminal
            terminal.scrollTop = terminal.scrollHeight;
        }

        function resetView() {
            currentFilter = 'ALL';
            document.getElementById('module-grid').classList.remove('hidden');
            document.getElementById('script-details-container').classList.remove('active');
            document.getElementById('module-header-title').innerText = 'Module Interface Array';
            document.getElementById('module-filter-text').innerText = 'FILTER: [ALL]';
            renderModules();
        }

        // Initialize modules on load and handle CLI interaction simulation
        document.addEventListener('DOMContentLoaded', () => {
            renderModules();
            
            const terminal = document.getElementById('cli-output');
            if(!terminal) return;
            
            // Add a slight flicker effect occasionally
            setInterval(() => {
                if(Math.random() > 0.9) {
                    terminal.style.opacity = '0.8';
                    setTimeout(() => terminal.style.opacity = '1', 50);
                }
            }, 2000);
        });
    </script>








</body></html>