                iconPath: '<path d="M4 6h16M4 12h16m-7 6h7" stroke-linecap="square"></path><circle cx="7" cy="18" r="2"></circle>',
                config: '{"filter_hz": 120, "auto_sort": true, "track_cache": "memory"}'
            },
            {
