<!-- Main Content Canvas -->
<main class="relative z-10 pb-4 px-gutter md:px-margin-md max-w-[1920px] mx-auto flex-1 flex flex-col w-full overflow-hidden gap-4 pt-16">
<!-- Hero Section -->
<section class="flex flex-col lg:flex-row gap-gutter fade-slide-up shrink-0 md:gap-4" style="animation-delay: 0.1s;">
<!-- Title & CLI -->
<div class="flex-1 flex flex-col gap-3">
<div>
<h1 class="font-headline-lg-mobile md:font-headline-xl text-headline-lg-mobile md:text-headline-xl text-[#98f05f] mb-2 drop-shadow-[0_0_8px_rgba(152,240,95,0.3)] uppercase"><div><span class="" style="letter-spacing: -0.02em;">COMMAND_CENTRE</span></div></h1>
