            },
            {
                id: 'raceThemeChanger',
                tier: 'free',
                title: 'Race Theme Changer',
                desc: 'Custom aesthetic overrides for race UI.',
                version: 'v1.2.6',
                category: 'UI Mod',
                badge: 'live',
                badgeText: 'LIVE',
                iconPath: '<path d="M12 2v20m-7-7l7 7 7-7"></path>',
