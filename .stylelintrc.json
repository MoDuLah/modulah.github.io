{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-charset-rule-no-invalid": null,
    "at-rule-descriptor-no-unknown": null,
    "at-rule-descriptor-value-no-unknown": null,
    "at-rule-no-deprecated": null,
    "at-rule-prelude-no-invalid": null,
    "block-no-redundant-nested-style-rules": null,
    "color-function-alias-notation": null,
    "container-name-pattern": null,
    "selector-class-pattern": null,
    "selector-id-pattern": null,
    "alpha-value-notation": null,
    "at-rule-empty-line-before": null,
    "color-function-notation": null,
    "color-no-invalid-hex": true,
    "custom-property-empty-line-before": null,
    "font-family-no-missing-generic-family-keyword": true,
    "media-feature-range-notation": null,
    "no-duplicate-selectors": true,
    "no-empty-source": true,
    "unit-no-unknown": true,
    "property-no-unknown": true,
    "declaration-block-no-duplicate-properties": true,
    "declaration-block-no-shorthand-property-overrides": true,
    "declaration-property-value-keyword-no-deprecated": null,
    "declaration-property-value-no-unknown": null,
    "block-no-empty": true,
    "function-linear-gradient-no-nonstandard-direction": true,
    "function-no-unknown": true,
    "selector-pseudo-class-no-unknown": true,
    "selector-pseudo-element-no-unknown": true,
    "selector-no-deprecated": null,
    "selector-no-invalid": null,
    "selector-no-unmatchable": null,
    "media-feature-name-no-unknown": true,
    "media-feature-name-value-no-unknown": null,
    "media-type-no-deprecated": null,
    "at-rule-no-unknown": true,
    "comment-no-empty": true,
    "no-duplicate-at-import-rules": true,
    "no-invalid-double-slash-comments": true,
    "no-invalid-position-declaration": null,
    "nesting-selector-no-missing-scoping-root": null,
    "property-no-deprecated": null,
    "syntax-string-no-invalid": null,
    "rule-empty-line-before": null,
    "string-no-newline": true,
    "value-keyword-case": null,
    "value-no-invalid": null,
    "layer-name-pattern": null,
    "function-calc-no-unspaced-operator": true,
    "function-url-quotes": "always",
    "length-zero-no-unit": true,
    "no-descending-specificity": null
  },
  "ignoreFiles": [
    "node_modules/**/*.css",
    "pit-guru/exports/**/*.html"
  ]
}
