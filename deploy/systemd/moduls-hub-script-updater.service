[Unit]
Description=MoDuL Hub script version manifest update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=moduls-hub-updater
StateDirectoryMode=0755
WorkingDirectory=/opt/moduls-hub-updater
EnvironmentFile=/etc/moduls-hub-updater.env
ExecStart=/usr/bin/python3 /opt/moduls-hub-updater/sync-versions.py --config /opt/moduls-hub-updater/script-update-sources.json --site-root /var/www/moduls-hub/current --output /var/lib/moduls-hub-updater/script-updates.json --write
ExecStartPost=+/usr/bin/install -m 0644 /var/lib/moduls-hub-updater/script-updates.json /var/www/moduls-hub/current/assets/data/.script-updates.json.new
ExecStartPost=+/usr/bin/mv -f /var/www/moduls-hub/current/assets/data/.script-updates.json.new /var/www/moduls-hub/current/assets/data/script-updates.json
TimeoutStartSec=4min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/www/moduls-hub/current/assets/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
